          },
          "docs": "Transfers a reward certificate NFT from a source wallet to a target wallet. Source and target should be EVM wallet addresses (0x...)."
        },
        {
          "info": {
            "name": "List wallets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.crown-brlv.com/api/v1/accounts/:account-id/wallets",
