          },
          "docs": "Returns the total available balance that can be claimed"
        },
        {
          "info": {
            "name": "Submit a claim request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.crown-brlv.com/api/v0/claims",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a claim for a specified amount from reward certificates"
        },
        {
          "info": {
            "name": "List claimable reward certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.crown-brlv.com/api/v0/claims/certificates"
          },
          "docs": "Returns a list of reward certificates with their claimable amounts"
        }
      ]
    }
  ],
  "bundled": true
